PUBLIC_DOMAIN=docs.example.com
PUBLIC_ORIGIN=https://docs.example.com
POSTGRESQL_PASSWORD=replace-with-a-url-safe-database-password
DATABASE_URL=postgresql://zipline:replace-with-a-url-safe-database-password@postgresql:5432/zipline
CORE_SECRET=replace-with-a-long-random-secret
CORE_HOSTNAME=0.0.0.0
CORE_PORT=3000
CORE_RETURN_HTTPS_URLS=true
CORE_DEFAULT_DOMAIN=docs.example.com
CORE_TRUST_PROXY=true
DATASOURCE_TYPE=s3
DATASOURCE_S3_ACCESS_KEY_ID=replace-with-an-s3-access-key-id
DATASOURCE_S3_SECRET_ACCESS_KEY=replace-with-an-s3-secret-access-key
DATASOURCE_S3_REGION=eu-north-1
DATASOURCE_S3_BUCKET=replace-with-a-private-bucket-name
DATASOURCE_S3_SUBDIRECTORY=files
