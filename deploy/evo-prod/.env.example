PUBLIC_ORIGIN=https://doc.evolveapp.org
NGINX_NETWORK=srv_lms-net
POSTGRESQL_PASSWORD=replace-with-a-url-safe-random-password
DATABASE_URL=postgresql://zipline:replace-with-a-url-safe-random-password@postgresql:5432/zipline
CORE_SECRET=replace-with-a-random-secret-at-least-32-characters-long
CORE_HOSTNAME=0.0.0.0
CORE_PORT=3000
CORE_RETURN_HTTPS_URLS=true
CORE_DEFAULT_DOMAIN=doc.evolveapp.org
CORE_TRUST_PROXY=true
DATASOURCE_TYPE=local
DATASOURCE_LOCAL_DIRECTORY=/zipline/uploads
CORE_TEMP_DIRECTORY=/zipline/uploads/.tmp
FILES_LENGTH=20
FILES_MAX_FILE_SIZE=2gb
CHUNKS_ENABLED=true
CHUNKS_MAX=2gb
CHUNKS_SIZE=10mb
FEATURES_HEALTHCHECK=true
FEATURES_USER_REGISTRATION=false
FEATURES_OAUTH_REGISTRATION=false
INVITES_ENABLED=false
FEATURES_THUMBNAILS_NUM_THREADS=1
WEBSITE_TITLE=Evolve Documents
